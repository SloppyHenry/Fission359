<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-FileCopyrightText: Fission3D contributors -->
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component type="desktop-application">
  <id>@FISSION_APP_ID@</id>
  <name>@FISSION_APP_NAME@</name>
  <summary>Easy and precise 3D design for makers</summary>
  <summary xml:lang="de">3D-Konstruktion, einfach und präzise</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.sloppyhenry">
    <name>Fission3D contributors</name>
  </developer>
  <description>
    <p>Fission3D is a 3D design program that is as easy to pick up as Tinkercad and as precise as
    Fusion. Build functional parts and playful decorations, prepared for FDM 3D printing.</p>
    <p xml:lang="de">Fission3D ist ein 3D-Konstruktionsprogramm, das so einfach ist wie Tinkercad und
    so präzise wie Fusion. Damit entstehen funktionale Teile und verspielte Deko, vorbereitet für
    den FDM-3D-Druck.</p>
  </description>
  <launchable type="desktop-id">@FISSION_APP_ID@.desktop</launchable>
  <provides>
    <binary>fission3d</binary>
    <mediatype>@FISSION_MIME_TYPE@</mediatype>
  </provides>
  <url type="homepage">https://github.com/SloppyHenry/Fission3D</url>
  <url type="bugtracker">https://github.com/SloppyHenry/Fission3D/issues</url>
  <categories>
    <category>Graphics</category>
    <category>3DGraphics</category>
    <category>Engineering</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@PROJECT_VERSION@" date="@FISSION_RELEASE_DATE@" type="development"/>
  </releases>
</component>
