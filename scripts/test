#!/usr/bin/env bash
# SPDX-FileCopyrightText: Fission359 contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Baut Fission359 und führt alle Tests aus, mit verständlicher Zusammenfassung.
#
#   scripts/test             Debug-Version testen
#   scripts/test --release   optimierte Version testen
#   scripts/test --asan      mit Speicherfehler-Erkennung (AddressSanitizer) testen

set -u -o pipefail
# shellcheck source=lib/common.sh
. "$(dirname "$0")/lib/common.sh"

KIND=debug
while [ $# -gt 0 ]; do
    case "$1" in
        --release) KIND=release ;;
        --asan)    KIND=asan ;;
        --help|-h) sed -n '5,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "Unbekannte Option '$1'. Siehe scripts/test --help" ;;
    esac
    shift
done

PRESET="$(preset_name "$KIND")"
BUILD_DIR="$REPO_ROOT/build/$PRESET"
BUILD_LOG="$BUILD_DIR.log"
TEST_LOG="$BUILD_DIR.tests.log"

need_command cmake
need_command ninja
apply_job_limit
cd "$REPO_ROOT" || exit 1

# Plain-language names for the tests that are not unit tests.
describe_test() {
    case "$1" in
        license_headers)             echo "Alle Quelldateien tragen den Lizenz-Kopf (SPDX)" ;;
        layer_includes)              echo "Schichtregel im Quelltext: Qt und Kernel-Typen nur, wo erlaubt" ;;
        app_opens_window)            echo "Die App startet und zeigt ihr Fenster" ;;
        app_window_dark)             echo "Das Fenster erscheint im dunklen Design (Bild entsteht)" ;;
        app_window_light)            echo "Das Fenster erscheint im hellen Design (Bild entsteht)" ;;
        app_window_dark_matches_design)
                                     echo "Das dunkle Fenster entspricht dem Design (Farben, Würfel sichtbar)" ;;
        app_window_light_matches_design)
                                     echo "Das helle Fenster entspricht dem Design (Farben, Würfel sichtbar)" ;;
        app_start_time)              echo "Startzeit unter 3 Sekunden (bis zum ersten Bild)" ;;
        translations_complete)       echo "Alle Texte sind übersetzt (Deutsch und Englisch), nichts ist fest eingebaut" ;;
        app_prints_version)          echo "Die App meldet ihre Version und die geladene OpenCASCADE-Version" ;;
        layering_control_builds)     echo "Kontrolle: Core-Code ohne Qt lässt sich bauen" ;;
        layering_rejects_qt_in_core) echo "Schichtregel: Qt in Core wird vom Compiler abgelehnt" ;;
        third_party_licenses)        echo "Alle Bibliotheken haben GPL-3-kompatible Lizenzen" ;;
        third_party_notices_current) echo "Das Lizenzinventar (THIRD_PARTY_NOTICES.md) ist aktuell" ;;
        third_party_rejects_forbidden_license)
                                     echo "Kontrolle: eine unverträgliche Lizenz wird abgelehnt" ;;
        "smoke: OpenCASCADE builds a box with the right volume")
                                     echo "Bibliothek OpenCASCADE: Quader mit richtigem Volumen" ;;
        "smoke: OpenCASCADE cuts a hole into a box")
                                     echo "Bibliothek OpenCASCADE: Loch in einen Quader schneiden" ;;
        "smoke: Manifold subtracts a sphere from a cube")
                                     echo "Bibliothek Manifold: Würfel minus Kugel" ;;
        "smoke: PlaneGCS solves a point at a given distance on the x axis")
                                     echo "Bibliothek PlaneGCS: Skizzen-Bedingungen lösen" ;;
        "smoke: Eigen solves a small linear system")
                                     echo "Bibliothek Eigen: Gleichungssystem lösen" ;;
        "smoke: lib3mf writes and reads back a 3MF file")
                                     echo "Bibliothek lib3mf: 3MF-Datei schreiben und lesen" ;;
        "smoke: minizip-ng writes and reads back a zip file")
                                     echo "Bibliothek minizip-ng: ZIP-Datei schreiben und lesen" ;;
        "smoke: nanosvg parses a small SVG")
                                     echo "Bibliothek nanosvg: SVG lesen" ;;
        "smoke: stb writes and reads back a PNG")
                                     echo "Bibliothek stb: PNG schreiben und lesen" ;;
        "smoke: nlohmann-json parses and writes JSON")
                                     echo "Bibliothek nlohmann-json: JSON lesen und schreiben" ;;
        "smoke: spdlog formats a log line")
                                     echo "Bibliothek spdlog: Protokollzeile formatieren" ;;
        *)                           echo "Unit-Test: $1" ;;
    esac
}

step "Baue Fission359 ($PRESET)"
note "Beim ersten Mal werden die Bibliotheken gebaut (15-30 Minuten). Fortschritt: tail -f build/$PRESET.log"
mkdir -p "$REPO_ROOT/build"
if ! { cmake --preset "$PRESET" && cmake --build --preset "$PRESET"; } >"$BUILD_LOG" 2>&1; then
    fail "Das Bauen ist fehlgeschlagen. Die letzten Zeilen des Protokolls:"
    tail -n 25 "$BUILD_LOG" | sed 's/^/    /'
    note "Fehlen vielleicht Voraussetzungen? Dann hilft:  scripts/setup"
    exit 1
fi
ok "Gebaut"

step "Führe Tests aus"
# Linux: no screen needed (the window tests start their own virtual one). macOS: the window tests
# use the real window system of the Mac, so nothing is forced there.
if [ "$(detect_os)" != "macos" ]; then
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
fi
ctest --preset "$PRESET" >"$TEST_LOG" 2>&1
CTEST_EXIT=$?

PASSED=0
FAILED=0
GEO_TOTAL=0
NAMING_TOTAL=0
FAILED_NAMES=()
while IFS= read -r line; do
    # Lines look like: "3/7 Test  #3: app_opens_window .... Passed  0.93 sec"
    case "$line" in
        *"Test "*"#"*"..."*)
            name="$(printf '%s' "$line" | sed -E 's/^.*Test +#[0-9]+: (.*[^. ]) \.+ .*$/\1/')"
            # The kernel robustness catalog has dozens of cases: report it as one line.
            case "$name" in
                "geometry: "*)
                    GEO_TOTAL=$((GEO_TOTAL + 1))
                    case "$line" in
                        *"Passed"*) PASSED=$((PASSED + 1)) ;;
                        *)          FAILED=$((FAILED + 1)); FAILED_NAMES+=("$name")
                                    fail "Konstruktionsfall: ${name#geometry: }" ;;
                    esac
                    continue ;;
                "naming: "*)
                    NAMING_TOTAL=$((NAMING_TOTAL + 1))
                    case "$line" in
                        *"Passed"*) PASSED=$((PASSED + 1)) ;;
                        *)          FAILED=$((FAILED + 1)); FAILED_NAMES+=("$name")
                                    fail "Referenz-Szenario: ${name#naming: }" ;;
                    esac
                    continue ;;
            esac
            case "$line" in
                *"Passed"*) PASSED=$((PASSED + 1)); ok "$(describe_test "$name")" ;;
                *)          FAILED=$((FAILED + 1)); FAILED_NAMES+=("$name"); fail "$(describe_test "$name")" ;;
            esac ;;
    esac
done <"$TEST_LOG"

if [ "$GEO_TOTAL" -gt 0 ]; then
    ok "Geometrie-Kern: $GEO_TOTAL typische Konstruktionsfälle geprüft (Bericht: docs/spikes/kernel-robustheit.md)"
fi

if [ "$NAMING_TOTAL" -gt 0 ]; then
    ok "Persistente Referenzen: $NAMING_TOTAL Szenarien, böse Fälle und Zufallsproben geprüft, nichts still falsch zugeordnet (Bericht: docs/spikes/persistente-referenzen.md)"
fi

say ""
if [ "$CTEST_EXIT" -eq 0 ] && [ "$FAILED" -eq 0 ] && [ "$PASSED" -gt 0 ]; then
    say "${C_GREEN}${C_BOLD}Alles in Ordnung: $PASSED von $PASSED Tests bestanden.${C_RESET}"
    exit 0
fi

say "${C_RED}${C_BOLD}Nicht in Ordnung: $FAILED Test(s) fehlgeschlagen, $PASSED bestanden.${C_RESET}"
note "Details stehen in build/$PRESET.tests.log"
tail -n 30 "$TEST_LOG" | sed 's/^/    /'
exit 1
